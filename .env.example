# Скопируйте в .env и замените секреты.
# Пароль должен совпадать в POSTGRES_PASSWORD и DATABASE_URL.
APP_ENV=development

POSTGRES_DB=ai_engineer
POSTGRES_USER=ai_engineer
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://ai_engineer:change-me-before-use@db:5432/ai_engineer

# Сгенерируйте: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-value

HASH_SCHEME=argon2
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

DEMO_AUTH_ENABLED=true
SESSION_TTL_SECONDS=28800

# 8080 — Nginx из Compose, 5173 — Vite, 8000 — Swagger.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

BACKEND_PORT=8000
FRONTEND_PORT=8080
LOG_LEVEL=INFO
